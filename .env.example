PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/college_events?replicaSet=rs0
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_EMAIL=admin@college.example
ADMIN_PASSWORD=choose-a-strong-password
BASE_URL=http://localhost:3000
NODE_ENV=development
# Chosen assignment default; the PDF does not specify a threshold.
BUDGET_THRESHOLD=10000
# Optional. Without SMTP, development signup shows a confirmation link locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus Events <no-reply@college.example>
